<div class="dropdown lg-down:dropup mbl:mr-1/8 mbl:ml-1/8 mb-1/16 mbl:mb-0 hide-when-noscript" data-dropdown>
  <button class="theme-switch" aria-label="Set a theme" data-action="toggle-dropdown get-partial" data-url="<%= theme_switch_partial_path %>" data-target="theme-switch">
    <%= vite_inline_svg_tag "images/icons/icon-theme.svg", width: 20, height: 20 %>

    <div class="theme-switch__label">
      Theme
    </div>
  </button>

  <div class="dropdown__content" data-dropdown-content data-partial="theme-switch">
    <div class="spinner spinner--small ml-1/4 mt-1/8 mb-1/4" aria-live="polite" role="status"></div>
  </div>
</div>
