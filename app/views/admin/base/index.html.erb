<% content_for :page_title, "Admin dashboard" %>

<%= render "admin/navigation" %>

<p>
  <strong>Analytics since:</strong>

  <span class="button-group inline-flex ml-1/4">
    <%= link_to "1 week ago", admin_root_path(from: 1.week.ago, period: "short"), class: "button button--secondary button--small" %>
    <%= link_to "2 weeks ago", admin_root_path(from: 2.weeks.ago, period: "short"), class: "button button--secondary button--small" %>
    <%= link_to "1 month ago", admin_root_path(from: 1.month.ago, period: "short"), class: "button button--secondary button--small" %>
    <%= link_to "6 months ago", admin_root_path(from: 6.months.ago, period: "short"), class: "button button--secondary button--small" %>
    <%= link_to "1 year ago", admin_root_path(from: 1.year.ago), class: "button button--secondary button--small" %>
    <%= link_to "2 years ago", admin_root_path(from: 2.years.ago), class: "button button--secondary button--small" %>
    <%= link_to "Forever", admin_root_path, class: "button button--secondary button--small" %>
  </span>
</p>

<div class="flex gap-1/4">
  <div style="width: 33.33%">
    <h3>Unique visits (8 hour sessions)</h3>

    <div class="chart-wrapper pb-0">
      <div class="chart" data-role="chart" data-data="<%= @unique_visits.to_json %>"></div>
    </div>
  </div>

  <div style="width: 33.33%">
    <h3>Unique copies</h3>

    <div class="chart-wrapper pb-0">
      <div class="chart" data-role="chart" data-data="<%= @unique_copies.to_json %>"></div>
    </div>
  </div>

  <div style="width: 33.33%">
    <h3>Page views</h3>

    <div class="chart-wrapper pb-0">
      <div class="chart" data-role="chart" data-data="<%= @page_views.to_json %>"></div>
    </div>
  </div>
</div>

<div data-partial="analytics" class="mt-1/1">
  <%= tag.button "Load 24 hours analytics - may be slow",
                 class: "button button--square button--secondary",
                 data: { action: "get-partial", url: admin_analytics_partial_path, target: "analytics" } %>
</div>

<hr>

<h3>Response time</h3>

<div class="status">
  <%= svelte_component("StatusChart", { linked: "status", data: [], fill: "var(--primary)", showValue: true, valueAppend: "ms", scaleMax: 3000, barMinWidth: 1, gap: 0, grow: true, height: 200, width: 2000 }) %>
  <%= svelte_component("LinkedLabel", { linked: "status", empty: "..." }) %>
  <div data-role="status-average">Average: ...</div>

  <style>
    .status {
      background: var(--bg-darker);
      padding: 1rem;
      border-radius: 1rem;
    }

    [data-svelte-component="StatusChart"] svg {
      width: 100%;
    }
  </style>
</div>

<hr>

<h3>Inspect path</h3>

<p>Enter a path to view some quick and dirty page view stats of that path.</p>

<%= form_with method: :get do |form| %>
  <%= form.text_field :inspect_path, value: params[:inspect_path], class: "form-input", style: "max-width: 200px;" %>
<% end %>

<% if params[:inspect_path].present? %>
  <p>
    Views in the last <em>24 hours</em>: <strong><%= Ahoy::Event.where("time > ?", 1.day.ago).where(name: "Page View").map { |event| event.properties[:url].include?(params[:inspect_path]) }.size %></strong><br>
    Views in the last <em>7 days</em>: <strong><%= Ahoy::Event.where("time > ?", 7.days.ago).where(name: "Page View").map { |event| event.properties[:url].include?(params[:inspect_path]) }.size %></strong>
  </p>
<% end %>

<hr>

<h3 class="mt-1/1">Admin activity log</h3>

<% @admin_activity.each do |activity| %>
  <div class="well block mb-1/8">
    <div class="mb-1/4 text-lightest">
      <small><%= time_ago_in_words(activity.created_at) %> ago &nbsp;</small>
      <strong><%= activity.user.username %></strong> - <%= activity.content_type %>
    </div>

    <div>
      <strong>Relevant data:</strong> <%= activity.properties.to_json %>
    </div>
  </div>
<% end %>
