<%= paginator.render do %>
  <div class="pagination">
    <%= prev_page_tag %>

    <% paginator.each_page do |page| %>
      <% if page.display_tag? %>
        <%= page_tag page %>
      <% elsif !page.was_truncated? && !page.first? && !page.last? %>
        <div class="gap">...</div>
      <% end %>
    <% end %>

    <%= next_page_tag %>
  </div>
<% end %>
